{
  "name": "modtoken",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "build": { "command": "bun run build", "watch_dir": "web" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    // production: a database of its own (schema.sql). The older databases (modtoken, modtoken-solo, modtoken-events) are kept as an archive to merge from.
    { "binding": "DB", "database_name": "modtoken-prod", "database_id": "c7f9163b-b1d8-4cea-865d-d256c73dd97f" },
    // every event with its harmless attributes, for the statistics (events-schema.sql); the Worker works without it
    { "binding": "EVENTS", "database_name": "modtoken-events-prod", "database_id": "ac339651-a338-492c-87a1-058f7c9de142" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://billowing-feather-dc63.cloudflareaccess.com",
    // the Access applications whose login is accepted (comma separated): ait.bdev.pp.ua, and the first one that still serves track.bdev.pp.ua
    "POLICY_AUD": "8cc04182557c86721f8b55a4b257665342ac043eceeecb6d198dbd4245076fef,093672a00c66038093a36f747d866eb508b1d8e4be440a0e5b9a0c91313803a2"
  },
  // Worker Previews (branches other than the production one): own D1 database, own Access audience.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "modtoken-solo", "database_id": "d742cf9d-de3f-4fc4-bdc7-7510c0d48926" },
      { "binding": "EVENTS", "database_name": "modtoken-events", "database_id": "5ca6f594-2e9a-47b9-b116-4fee3b306250" }
    ],
    "vars": {
      "TEAM_DOMAIN": "https://billowing-feather-dc63.cloudflareaccess.com",
      "DEBUG_OTLP": "1", // preview only: keep one MASKED sample of every event kind (otlp_seen.sample); "raw" keeps it unmasked (temporary use only)
      // the Audience tag of the Cloudflare Access application that covers the Preview URLs (same as production here)
      "POLICY_AUD": "093672a00c66038093a36f747d866eb508b1d8e4be440a0e5b9a0c91313803a2"
    }
  }
}
