{
  "name": "modtoken",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "build": { "command": "bun run build", "watch_dir": "web" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "modtoken", "database_id": "ecefe683-56d6-4e79-bc16-a62c6c5591e4" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://billowing-feather-dc63.cloudflareaccess.com",
    "POLICY_AUD": "093672a00c66038093a36f747d866eb508b1d8e4be440a0e5b9a0c91313803a2"
  },
  // Worker Previews (branches other than the production one): own D1 database, own Access audience.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "modtoken-solo", "database_id": "d742cf9d-de3f-4fc4-bdc7-7510c0d48926" }
    ],
    "vars": {
      "TEAM_DOMAIN": "https://billowing-feather-dc63.cloudflareaccess.com",
      "DEBUG_OTLP": "raw", // TEMPORARY, preview only: keep the last RAW record of every event kind (otlp_seen.sample); set to "1" (masked) or remove
      // the Audience tag of the Cloudflare Access application that covers the Preview URLs (same as production here)
      "POLICY_AUD": "093672a00c66038093a36f747d866eb508b1d8e4be440a0e5b9a0c91313803a2"
    }
  }
}
