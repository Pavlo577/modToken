{
  "name": "token-tracker",
  "version": "0.3.0",
  "description": "Sends per-turn token usage and timing to Supabase so several devices roll up into one dashboard.",
  "userConfig": {
    "supabaseUrl": {
      "type": "string",
      "title": "Supabase URL",
      "description": "https://<ref>.supabase.co",
      "default": ""
    },
    "deviceToken": {
      "type": "string",
      "title": "Device token",
      "description": "Per-device token from create_device()",
      "default": "",
      "sensitive": true
    }
  }
}