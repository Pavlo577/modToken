{
  "token-tracker": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/token-tracker/hooks/activity.py SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/token-tracker/hooks/activity.py PreInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/token-tracker/hooks/activity.py Stop",
        "timeout": 10
      }
    ]
  }
}
