{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false, "isolatedModules": true, "types": []
  },
  "include": ["**/*.ts"]
}
